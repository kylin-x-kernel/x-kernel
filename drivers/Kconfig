    bool "virtio-gpu display"
    help
      Enable the virtio-gpu display driver.

config KFEAT_DRIVER_VIRTIO_INPUT
    bool "virtio-input input device"
    help
      Enable the virtio-input input device driver.

endmenu # Device Drivers
