menu "Drivers Basic Configuration"

config PSCI_METHOD
    string "PSCI Method"
    default "hvc"
    depends on ARCH_AARCH64
    help
      Specify the method used for Power State Coordination Interface (PSCI) calls.

config PHYS_BUS_OFFSET
    hex "Physical Bus Offset"
    default 0x0
    help
      Specify the physical bus offset for device memory mapping.

config KFEAT_PCI_NON_ECAM
    bool "Enable non-ECAM PCI discovery quirks"
    help
      Enable the PCI quirks needed on guests whose PCI fabric does not behave
      like a fully standard ECAM implementation.

config PCI_ECAM_BASE
    hex "PCI ECAM Base Address"
    default 0x40100000000
    help
      Define the base address for PCI Express Configuration Access Mechanism (ECAM).

config PCI_BUS_END
    hex "PCI Bus End"
    default 0xff
    help
      Set the end bus number for PCI devices.

config PCI_RANGES
    rangetype "PCI Address Ranges"
    default [(u64, u64)]
    help
      Specify the address ranges for PCI devices.

config BOOT_CONSOLE_TYPE
    string "Boot console transport"
    default "mmio" if ARCH_AARCH64
    default "mmio" if ARCH_RISCV64
    default "ioport" if ARCH_X86_64
    help
      Select how the boot console is accessed before the runtime console is
      initialized.
      - "mmio": BOOT_CONSOLE_ADDR is a physical MMIO base address.
      - "ioport": BOOT_CONSOLE_ADDR is a legacy x86 I/O port base.
      Set BOOT_CONSOLE_ADDR to 0 to disable boot-stage console output.

config BOOT_CONSOLE_ADDR
    hex "Boot console base address"
    default 0x0
    default 0x3f8 if ARCH_X86_64
    help
      Define the boot console base address used only for boot-time diagnostics
      before the runtime console driver is initialized.
      For BOOT_CONSOLE_TYPE="mmio", this is a physical MMIO base address.
      For BOOT_CONSOLE_TYPE="ioport", this is a legacy I/O port base.

config RTC_PADDR
    hex "RTC Base Address"
    help
      Define the base address for the RTC (Real-Time Clock) device.

menu "IRQ Configuration"

config PMU_IRQ
    usize "PMU IRQ Number"
    default 23
    depends on ARCH_AARCH64
    default 23
    depends on ARCH_AARCH64
    help
      Define the interrupt number for the Performance Monitoring Unit (PMU).

config ARM_GENERIC_TIMER_MODE
    string "ARM generic timer mode"
    depends on ARCH_AARCH64
    default "physical"
    help
      Select which architected timer view EL1 should use.
      - "physical": use CNTPCT_EL0/CNTP_* registers.
      - "virtual": use CNTVCT_EL0/CNTV_* registers.
      For virtcca-like guests where EL1 physical timer access is trapped,
      set this to "virtual".

config IPI_IRQ
    usize "IPI IRQ Number"
    default 1
    help
      Define the interrupt number for Inter-Processor Interrupts (IPI).

endmenu # IRQ Configuration

menu "Device Drivers Features"

choice
    prompt "Virtio Bus Type"
    default KFEAT_VIRTIO_BUS_PCI

config KFEAT_VIRTIO_BUS_PCI
    bool "PCI Virtio_Bus Support"
    help
      Enable PCI virtio bus support.

config KFEAT_VIRTIO_BUS_MMIO
    bool "MMIO Virtio_Bus Support"
    help
      Enable MMIO virtio bus support.

endchoice

config KFEAT_RTC
    bool "RTC (Real Time Clock) Support"
    default y
    help
      Enable Real Time Clock driver subsystem.

config KFEAT_DISPLAY
    bool "Display Driver Support"
    default y
    help
      Enable display driver support (virtio-gpu, fbdevice, etc).

config KFEAT_INPUT
    bool "Input Driver Support"
    default y
    help
      Enable input driver support (virtio-input, inputdev, etc).

config KFEAT_CHAR
    bool "Character Driver Support"
    default y
    help
      Enable runtime character device support. This covers devices that are
      exposed after early boot handoff or through the unified driver pipeline.
endmenu   # Device Drivers Features

endmenu # Drivers Basic Configuration

menu "Device Drivers"

comment "Block device drivers"

config KFEAT_DRIVER_VIRTIO_BLK
    bool "virtio-blk block device"
    depends on KFEAT_FS
    default y
    help
      Enable the virtio-blk block device driver. Required by virtio-based
      virtual platforms (QEMU/CrosVM) when a disk-backed filesystem is in use.

config KFEAT_DRIVER_RAMDISK
    bool "RAM disk block device"
    depends on KFEAT_FS
    help
      Use an in-memory RAM disk to back the filesystem. Useful on platforms
      that do not (yet) provide a real block device driver.

config KFEAT_DRIVER_RAMDISK_STATIC
    bool "Back the RAM disk with an embedded filesystem image"
    depends on KFEAT_DRIVER_RAMDISK
    help
      Populate the RAM disk from a build-time filesystem image embedded into
      the kernel, instead of an empty zero-filled region, so it can be mounted
      as a real (read-write) root filesystem. The image path is set by the
      RAMDISK_IMG Makefile variable (default: an empty ext4 image produced by
      'make ramdisk_img'); any ext4 image may be substituted. Select the
      matching filesystem backend (KFEAT_FS_EXT4 by default; KFEAT_FS_FAT if a
      FAT image is used). The image is embedded in .data, so the kernel binary
      grows by roughly the image size.

comment "Network drivers"

config KFEAT_DRIVER_VIRTIO_NET
    bool "virtio-net NIC"
    depends on KFEAT_NET
    default y
    help
      Enable the virtio-net NIC driver. Required by virtio-based virtual
      platforms (QEMU/CrosVM) when networking is in use.

config KFEAT_DRIVER_VIRTIO_SOCKET
    bool "virtio-vsock transport"
    depends on KFEAT_VSOCK
    default y
    help
      Enable the virtio-vsock transport driver used by AF_VSOCK on virtio
      platforms.

comment "Character drivers"

config KFEAT_DRIVER_CONSOLE_PL011
    bool "PL011 UART backend (early console)"
    depends on KFEAT_CHAR
    default y if PLATFORM_AARCH64_QEMU_VIRT
    help
      Build the PL011 UART backend used by the early-boot console and the
      per-instance serial driver.

config KFEAT_DRIVER_CONSOLE_NS16550_MMIO
    bool "NS16550 MMIO UART backend (early console)"
    depends on KFEAT_CHAR
    default y if PLATFORM_RISCV64_QEMU_VIRT
    default y if PLATFORM_LOONGARCH64_QEMU_VIRT
    help
      Build the NS16550 MMIO UART backend used by the early-boot console and
      the per-instance serial driver.

config KFEAT_DRIVER_CONSOLE_NS16550_IOPORT
    bool "NS16550 I/O-port UART backend (early console)"
    depends on KFEAT_CHAR && ARCH_X86_64
    default y if PLATFORM_X86_64_QEMU_VIRT
    help
      Build the NS16550 I/O-port UART backend used by the early-boot console
      and the per-instance serial driver.

config KFEAT_DRIVER_SERIAL_PL011
    bool "PL011 per-instance serial driver"
    depends on KFEAT_CHAR
    select KFEAT_DRIVER_CONSOLE_PL011
    default y if PLATFORM_AARCH64_QEMU_VIRT
    help
      Enable the kdriver per-instance serial driver for PL011 UARTs. Each UART
      node becomes a character device; the stdout UART shares the early-boot
      instance.

config KFEAT_DRIVER_SERIAL_NS16550_MMIO
    bool "NS16550 MMIO per-instance serial driver"
    depends on KFEAT_CHAR
    select KFEAT_DRIVER_CONSOLE_NS16550_MMIO
    default y if PLATFORM_RISCV64_QEMU_VIRT
    default y if PLATFORM_LOONGARCH64_QEMU_VIRT
    help
      Enable the kdriver per-instance serial driver for NS16550 MMIO UARTs.

config KFEAT_DRIVER_SERIAL_NS16550_IOPORT
    bool "NS16550 I/O-port per-instance serial driver"
    depends on KFEAT_CHAR && ARCH_X86_64
    select KFEAT_DRIVER_CONSOLE_NS16550_IOPORT
    default y if PLATFORM_X86_64_QEMU_VIRT
    help
      Enable the kdriver per-instance serial driver for the NS16550 I/O-port
      (x86 ISA COM) UART.

comment "Filesystem transport drivers"

config KFEAT_DRIVER_VIRTIO_9P
    bool "virtio-9p transport"
    depends on KFEAT_FS_9P
    default y
    help
      Enable the virtio-9p transport used by the 9P filesystem client (e.g.
      QEMU hostshare).

comment "Display / input drivers"

config KFEAT_DRIVER_VIRTIO_GPU
    bool "virtio-gpu display"
    help
      Enable the virtio-gpu display driver.

config KFEAT_DRIVER_VIRTIO_INPUT
    bool "virtio-input input device"
    help
      Enable the virtio-input input device driver.

endmenu # Device Drivers
