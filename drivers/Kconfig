menu "Drivers Basic Configuration"

config PSCI_METHOD
    string "PSCI Method"
    default "hvc"
    depends on ARCH_AARCH64
    help
      Specify the method used for Power State Coordination Interface (PSCI) calls.

config PHYS_BUS_OFFSET
    hex "Physical Bus Offset"
    default 0x0
    help
      Specify the physical bus offset for device memory mapping.

config KFEAT_PCI_NON_ECAM
    bool "Enable non-ECAM PCI discovery quirks"
    help
      Enable the PCI quirks needed on guests whose PCI fabric does not behave
      like a fully standard ECAM implementation.

config PCI_ECAM_BASE
    hex "PCI ECAM Base Address"
    default 0x40100000000
    help
      Define the base address for PCI Express Configuration Access Mechanism (ECAM).

config PCI_BUS_END
    hex "PCI Bus End"
    default 0xff
    help
      Set the end bus number for PCI devices.

config PCI_RANGES
    rangetype "PCI Address Ranges"
    default [(u64, u64)]
    help
      Specify the address ranges for PCI devices.

config BOOT_CONSOLE_TYPE
    string "Boot console transport"
    default "mmio" if ARCH_AARCH64
    default "mmio" if ARCH_RISCV64
    default "ioport" if ARCH_X86_64
    help
      Select how the boot console is accessed before the runtime console is
      initialized.
      - "mmio": BOOT_CONSOLE_ADDR is a physical MMIO base address.
      - "ioport": BOOT_CONSOLE_ADDR is a legacy x86 I/O port base.
      Set BOOT_CONSOLE_ADDR to 0 to disable boot-stage console output.

config BOOT_CONSOLE_ADDR
    hex "Boot console base address"
    default 0x0
    default 0x3f8 if ARCH_X86_64
    help
      Define the boot console base address used only for boot-time diagnostics
      before the runtime console driver is initialized.
      For BOOT_CONSOLE_TYPE="mmio", this is a physical MMIO base address.
      For BOOT_CONSOLE_TYPE="ioport", this is a legacy I/O port base.

config BOOT_CONSOLE_BAUDRATE
    hex "Boot console baud rate (bits/s)"
    default 0x0
    help
      The baud rate of the boot console UART. The early boot console (which runs
      before the runtime console driver and cannot poll the TX-ready bit) uses
      this to pace output at one byte time per character, so a fast core does not
      overrun the UART TX FIFO and drop characters. Set to 0 to disable pacing
      (emulated UARTs and PL011s with deep FIFOs do not need it). Only relevant
      for real MMIO 16550 consoles such as the RK3588 DesignWare UART.

config BOOT_CONSOLE_REG_IO_WIDTH
    usize "Boot console MMIO access width"
    default 1
    help
      The byte width used by the minimal AArch64 early boot console when it
      writes the UART data register before the runtime device-tree console
      driver is available. This mirrors the device-tree `reg-io-width`
      property for real MMIO UARTs such as the RK3588 DesignWare UART. Set to
      1 for byte accesses and 4 for 32-bit accesses.

config RTC_PADDR
    hex "RTC Base Address"
    help
      Define the base address for the RTC (Real-Time Clock) device.

menu "IRQ Configuration"

config PMU_IRQ
    usize "PMU IRQ Number"
    default 23
    depends on ARCH_AARCH64
    default 23
    depends on ARCH_AARCH64
    help
      Define the interrupt number for the Performance Monitoring Unit (PMU).

config ARM_GENERIC_TIMER_MODE
    string "ARM generic timer mode"
    depends on ARCH_AARCH64
    default "physical"
    help
      Select which architected timer view EL1 should use.
      - "physical": use CNTPCT_EL0/CNTP_* registers.
      - "virtual": use CNTVCT_EL0/CNTV_* registers.
      For virtcca-like guests where EL1 physical timer access is trapped,
      set this to "virtual".

config IPI_IRQ
    usize "IPI IRQ Number"
    default 1
    help
      Define the interrupt number for Inter-Processor Interrupts (IPI).

endmenu # IRQ Configuration

