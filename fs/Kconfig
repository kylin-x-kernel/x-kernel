menu "File Systems"

config KFEAT_FS
    bool "Enable filesystem support"
    default y
    help
      Enable the kernel filesystem stack and related runtime support.

choice
    prompt "Root filesystem"
    depends on KFEAT_FS
    default KFEAT_FS_EXT4

config KFEAT_FS_EXT4
    bool "ext4"
    help
      Use ext4 as the root filesystem.

config KFEAT_FS_FAT
    bool "FAT"
    help
      Use FAT as the root filesystem.

endchoice

choice
    prompt "Ext4 implementation"
    depends on KFEAT_FS_EXT4
    default KFEAT_FS_EXT4_KEXT4

config KFEAT_FS_EXT4_RSEXT4
    bool "rsext4 compatibility backend"
    help
      Use the current writable rsext4 compatibility backend.

config KFEAT_FS_EXT4_KEXT4
    bool "KExt4 checked backend (experimental)"
    help
      Use the checked KExt4 core through its KVFS adapter.

endchoice

config KFEAT_FS_TIMES
    bool "Enable filesystem timestamps"
    depends on KFEAT_FS
    help
      Enable timestamp-related filesystem behavior in the shared VFS and
      filesystem backends.

config KFEAT_FS_9P
    bool "Enable 9P filesystem support"
    depends on KFEAT_FS
    help
      Enable the 9P filesystem client used for shared-directory mounts such as
      QEMU hostshare.

endmenu
