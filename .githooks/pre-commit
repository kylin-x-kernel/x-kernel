#!/usr/bin/env bash
# x-kernel shared pre-commit hook.
#
# Runs test layout checks, the project formatter and clippy so commits which fail
# CI on `make fmt` / `make clippy` are caught locally first. The formatter
# auto-fixes and re-stages the staged Rust files; clippy only gates.
#
# Escape hatches (set for a single commit):
#   SKIP_FMT=1     git commit ...   # skip `make fmt`
#   SKIP_CLIPPY=1  git commit ...   # skip `make clippy`
#   SKIP_ALL=1     git commit ...   # skip all checks, including test layout
#
# This hook is enabled automatically by the Makefile on any
# `make ...` invocation; no manual setup is required after clone or pull.

# Outside a repository there is nothing to check. Inside one, checks fail closed;
# tool/setup failures require repair or an explicit local bypass above.
REPO_ROOT="$(git rev-parse --show-toplevel 2>/dev/null)" || exit 0
cd "$REPO_ROOT" || exit 0

if [ "${SKIP_ALL:-0}" = "1" ]; then
	echo "⏭️  pre-commit: SKIP_ALL=1, skipping all checks." >&2
	exit 0
fi

mapfile -t STAGED_RS < <(git diff --cached --name-only --diff-filter=ACM -- '*.rs')
# Clippy already checks layout. Standalone checks cover manifest-only changes,
# deletions, and commits where the configured Clippy path cannot run.
if [ "${#STAGED_RS[@]}" -eq 0 ] || [ "${SKIP_CLIPPY:-0}" = "1" ] || [ ! -f .config ]; then
	if ! make check_test_layout; then
		echo "pre-commit: layout check could not pass. See the diagnostics above for source or toolchain/setup errors." >&2
		echo "    Repair the failure; SKIP_ALL=1 explicitly bypasses local checks only, not CI." >&2
		exit 1
	fi
fi

# Formatting and Clippy are only relevant when Rust sources are staged.
if [ "${#STAGED_RS[@]}" -eq 0 ]; then
	exit 0
fi

# ---- fmt: auto-format, then re-stage the files that were staged ----
if [ "${SKIP_FMT:-0}" != "1" ]; then
	if ! make fmt; then
		echo "❌ pre-commit: 'make fmt' failed (is the pinned nightly toolchain installed?)." >&2
		echo "   bypass with: SKIP_FMT=1 git commit ..." >&2
		exit 1
	fi
	# Re-stage the staged .rs files that fmt may have rewritten.
	git add -- "${STAGED_RS[@]}" 2>/dev/null || true
fi

# ---- clippy: gate the commit ----
if [ "${SKIP_CLIPPY:-0}" != "1" ]; then
	if [ ! -f .config ]; then
		echo "⚠️  pre-commit: no .config found; 'make clippy' needs one — skipping clippy this commit." >&2
		echo "    CI still runs clippy: run 'cp platforms/<plat>/qemu_defconfig .config && make defconfig' before pushing." >&2
	elif ! make clippy; then
		echo "❌ pre-commit: 'make clippy' or its prerequisite checks failed. See the diagnostics above." >&2
		echo "   bypass with: SKIP_CLIPPY=1 git commit ..." >&2
		exit 1
	fi
fi

echo "✅ pre-commit: enabled checks passed." >&2
exit 0
