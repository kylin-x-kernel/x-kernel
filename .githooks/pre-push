#!/usr/bin/env bash
# x-kernel shared pre-push hook: block pushes of branches that are behind
# main -- the openKylin CI would reject them as DIVERGED before running a
# single test. Strictly read-only: it never rewrites history.
#
# Skip for one push: SKIP_REBASE=1 git push ...   (or SKIP_ALL=1, kept in
# sync with pre-commit). Output goes to stderr, matching pre-commit.

[ "${SKIP_REBASE:-0}" = "1" ] || [ "${SKIP_ALL:-0}" = "1" ] && exit 0

git rev-parse --git-dir >/dev/null 2>&1 || exit 0
mapfile -t LINES
[ "${#LINES[@]}" -eq 1 ] || exit 0                        # plain single-branch pushes only
read -r LOCAL_REF _ _ <<<"${LINES[0]}"
case "$LOCAL_REF" in refs/heads/*) ;; *) exit 0 ;; esac   # tags and "(delete)" are none of its business
BRANCH="$(git symbolic-ref --quiet --short HEAD)" || exit 0              # detached / mid-rebase
[ "refs/heads/$BRANCH" = "$LOCAL_REF" ] || exit 0                        # only the checked-out branch

git fetch --quiet origin main 2>/dev/null || {
	echo "⚠️  pre-push: cannot refresh origin/main, skipping the staleness check." >&2
	exit 0
}
behind="$(git rev-list --count "HEAD..origin/main" 2>/dev/null)" || {
	echo "⚠️  pre-push: cannot compare against origin/main, skipping the staleness check." >&2
	exit 0
}
[ "$behind" -gt 0 ] || exit 0

echo "❌ pre-push: $BRANCH is $behind commit(s) behind origin/main (the check assumes the PR targets main); the CI would reject it as DIVERGED." >&2
echo "   catch up first:  make rebase" >&2
echo "   then push again:  git push --force-with-lease   # not pushed before: plain git push" >&2
echo "   push anyway now:  SKIP_REBASE=1 git push ..." >&2
exit 1
