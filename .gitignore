# Cargo locks — the kernel and xtask workspace lockfiles are tracked for
# reproducible builds; keep ignoring lockfiles of other excluded standalone
# projects.
!/xtask/Cargo.lock
/xtask/*/Cargo.lock
/tee_apps/**/Cargo.lock
/uapps/**/Cargo.lock

