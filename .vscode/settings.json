{
  "rust-analyzer.cargo.target": "aarch64-unknown-none-softfloat",
  "rust-analyzer.cargo.allTargets": false,
  "rust-analyzer.cargo.buildScripts.enable": true,
  "rust-analyzer.check.workspace": false,
  "rust-analyzer.linkedProjects": [
    "entry/Cargo.toml",
  ],
  "rust-analyzer.cargo.features": [
    "qemu",
    "smp",
    "kfeat/alloc",
    "kfeat/alloc_slab",
    "kfeat/bus_pci",
    "kfeat/display",
    "kfeat/dwarf",
    "kfeat/fs",
    "kfeat/fs_ext4",
    "kfeat/fs_times",
    "kfeat/input",
    "kfeat/net",
    "kfeat/sched_eevdf",
    "kfeat/task_ext",
    "kfeat/tee",
    "kfeat/tee_ta_sign",
    "kfeat/vsock",
    "aarch64_qemu_virt"
  ],
  "rust-analyzer.cargo.extraEnv": {
    "RUSTC_BOOTSTRAP": "1",
    "RUSTFLAGS": "--cfg unittest --check-cfg cfg(unittest)",
    "K_PLAT_NAME": "aarch64-qemu-virt",
    "TARGET_DIR": "${workspaceFolder}/target"
  }
}