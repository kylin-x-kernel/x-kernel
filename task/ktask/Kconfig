menu "Task Scheduler"

choice
    prompt "Scheduler algorithm"
    default KFEAT_SCHED_EEVDF

config KFEAT_SCHED_FIFO
    bool "FIFO cooperative scheduler"
    help
      Use the FIFO cooperative scheduler. Tasks run to completion
      unless they explicitly yield.

config KFEAT_SCHED_RR
    bool "Round-robin preemptive scheduler"
    help
      Use the Round-robin preemptive scheduler. Each task gets a fixed
      time slice and is rotated fairly.

config KFEAT_SCHED_CFS
    bool "CFS (Completely Fair Scheduler)"
    help
      Use the Completely Fair Scheduler. Tasks are scheduled based on
      virtual runtime to ensure proportional CPU share.

config KFEAT_SCHED_EEVDF
    bool "EEVDF (Earliest Eligible Virtual Deadline First)"
    help
      Use the EEVDF scheduler. Tasks are scheduled by virtual deadline
      with eligibility checks, providing latency-sensitive fairness.

endchoice

config KFEAT_TASK_EXT
    bool "Enable task extended data"
    default y
    help
      Allow attaching user-defined extension data to each task.

menu "Task Diagnostics"

config KFEAT_SNAPSHOT
    bool "Task snapshot support"
    help
      Enable reusable task/CPU snapshot collection and backtrace dumping
      support in `ktask::snapshot`.

config KFEAT_SYSRQ
    bool "SysRq task snapshot trigger"
    depends on KFEAT_SNAPSHOT
    help
      Expose `/proc/sysrq-trigger` and route supported SysRq commands to the
      shared snapshot service.

config KFEAT_WATCHDOG
    bool "Watchdog diagnostics"
    depends on KFEAT_SNAPSHOT
    help
      Enable watchdog-driven diagnostic checks such as soft lockup detection
      and lock-wait heuristics.

config KFEAT_WATCHDOG_HARDLOCKUP
    bool "Watchdog hard lockup detection"
    depends on KFEAT_WATCHDOG
    depends on PLATFORM_AARCH64_QEMU_VIRT
    select KFEAT_PMU
    help
      Enable the hard lockup watchdog backend. On AArch64 QEMU virt this is
      currently implemented through the PMU-driven NMI path and global snapshot
      rendezvous.

endmenu

endmenu
