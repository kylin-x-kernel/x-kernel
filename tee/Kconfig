menu "Trusted Execution Environment (TEE)"

config KFEAT_TEE
    bool "Enable TEE support"
    help
      Enable the kernel's TEE integration, including TEE syscalls, task
      loading hooks, and the platform/runtime support used by current TEE
      capable targets.

if KFEAT_TEE

config KFEAT_TEE_TA_SIGN
    bool "Enable TA ELF signature verification"
    help
      Enable `.ta_signature` verification for TA ELF images loaded through the
      TEE path.

config KFEAT_VIRTCCA_HUK_KEY
    bool "Enable VirtCCA HUK key derivation"
    depends on ARCH_AARCH64
    default n
    help
      Enable the TEE hardware unique key path for ARM VirtCCA guests.
      The key is derived from the VirtCCA image key flow, so enable this
      only when running in a VirtCCA confidential guest environment.

config KFEAT_CSV_HUK_KEY
    bool "Enable CSV HUK key derivation"
    depends on ARCH_X86_64
    default n
    help
      Enable the TEE hardware unique key path for x86_64 CSV guests.
      The key is derived from the CSV sealing key flow, so enable this
      only when running in a CSV confidential guest environment.

endif #KFEAT_TEE


endmenu
