/* BEGIN_HEADER */
#include "mbedtls/sm2.h"
/* END_HEADER */

/* BEGIN_DEPENDENCIES
 * depends_on:MBEDTLS_SM2_C
 * END_DEPENDENCIES
 */

/* BEGIN_CASE depends_on:MBEDTLS_SELF_TEST */
void sm2_selftest()
{
    TEST_ASSERT( mbedtls_sm2_self_test( 1 ) == 0 );
}
/* END_CASE */

/* BEGIN_CASE depends_on:MBEDTLS_SM2_C */
void dec_vec_sm2(const char *key, data_t *M, data_t *C)
{    
    mbedtls_sm2_context ctx;
    unsigned char output[512];
    size_t olen;

    mbedtls_sm2_init(&ctx);
    //load group
    TEST_ASSERT( mbedtls_ecp_group_load(&ctx.grp, MBEDTLS_ECP_DP_SM2P256R1) == 0 );
    //read private key
    TEST_ASSERT( mbedtls_mpi_read_string(&ctx.d, 16, key) == 0 );
    //check private key
    TEST_ASSERT( mbedtls_ecp_check_privkey(&ctx.grp, &ctx.d) == 0 );
    //SM2 dectypt
    TEST_ASSERT( mbedtls_sm2_decrypt_raw(&ctx, MBEDTLS_MD_SM3, C->x,
                                       C->len, output, &olen) == 0);
    
    TEST_ASSERT( memcmp(output, M->x, M->len) );

}
/* END_CASE */

/* BEGIN_CASE depends_on:MBEDTLS_SM2_C */
void test_enc_dec_vec_sm2(const char *private_key, const char *public_key_x, const char *public_key_y, data_t *M)
{
    mbedtls_sm2_context ctx;
    unsigned char mesg[512];
    size_t mlen;
    unsigned char cipher[512];
    size_t clen;

    mbedtls_test_rnd_pseudo_info rnd_info;
    unsigned char buf[MBEDTLS_MD_MAX_SIZE];

    mbedtls_sm2_init(&ctx);
    memset(&rnd_info, 0x00, sizeof(mbedtls_test_rnd_pseudo_info));
    memset(buf, 0, sizeof(buf));
    TEST_ASSERT(mbedtls_test_rnd_pseudo_rand(&rnd_info, buf, sizeof(buf)) == 0);

    //load group
    TEST_ASSERT( mbedtls_ecp_group_load(&ctx.grp, MBEDTLS_ECP_DP_SM2P256R1) == 0 );
    //read private key
    TEST_ASSERT( mbedtls_mpi_read_string(&ctx.d, 16, private_key) == 0 );
    //read public key
    TEST_ASSERT( mbedtls_mpi_read_string(&(&ctx.Q)->X, 16, public_key_x) == 0 );
    TEST_ASSERT( mbedtls_mpi_read_string(&(&ctx.Q)->Y, 16, public_key_y) == 0 );
    TEST_ASSERT( mbedtls_mpi_lset(&(&ctx.Q)->Z, 1) == 0 );
    //TEST_ASSERT( mbedtls_ecp_point_read_string(&ctx.Q, 16, sm2_enc_pubkey_x, sm2_enc_pubkey_y) );
    //check private key
    TEST_ASSERT( mbedtls_ecp_check_privkey(&ctx.grp, &ctx.d) == 0 );
    //check pubilc key
    TEST_ASSERT( mbedtls_ecp_check_pubkey(&ctx.grp, &ctx.Q) == 0 );
    //SM2 Encrypt
    TEST_ASSERT( mbedtls_sm2_encrypt_raw(&ctx, MBEDTLS_MD_SM3, M->x,
                                       M->len, cipher, &clen, &mbedtls_test_rnd_pseudo_rand, &rnd_info) == 0 );
    //SM2 Decrypt
    TEST_ASSERT( mbedtls_sm2_decrypt_raw(&ctx, MBEDTLS_MD_SM3, cipher, clen, mesg, &mlen) == 0 );
    //Compare mesg and cipher
    TEST_ASSERT( memcmp(mesg, M->x, M->len) == 0 );
}
/* END_CASE */

/* BEGIN_CASE depends_on:MBEDTLS_SM2_C */
void sgn_vec_sm2(const char *private_key, const char *public_key_x, const char *public_key_y, data_t *M,const char* user_id)
{
    mbedtls_sm2_context ctx;
    unsigned char hash_z[32];
    unsigned char hash_md[32];
    unsigned char sgn[512];
    size_t slen;

    mbedtls_test_rnd_pseudo_info rnd_info;
    unsigned char buf[MBEDTLS_MD_MAX_SIZE];

    mbedtls_sm2_init(&ctx);
    memset(&rnd_info, 0x00, sizeof(mbedtls_test_rnd_pseudo_info));
    memset(buf, 0, sizeof(buf));
    TEST_ASSERT(mbedtls_test_rnd_pseudo_rand(&rnd_info, buf, sizeof(buf)) == 0);

    //load group
    TEST_ASSERT( mbedtls_ecp_group_load(&ctx.grp, MBEDTLS_ECP_DP_SM2P256R1) == 0 );
    //read private key
    TEST_ASSERT( mbedtls_mpi_read_string(&ctx.d, 16, private_key) == 0 );
    //read public key
    TEST_ASSERT( mbedtls_mpi_read_string(&(&ctx.Q)->X, 16, public_key_x) == 0 );
    TEST_ASSERT( mbedtls_mpi_read_string(&(&ctx.Q)->Y, 16, public_key_y) == 0 );
    TEST_ASSERT( mbedtls_mpi_lset(&(&ctx.Q)->Z, 1) == 0 );
    //check private key
    TEST_ASSERT( mbedtls_ecp_check_privkey(&ctx.grp, &ctx.d) == 0 );
    //check pubilc key
    TEST_ASSERT( mbedtls_ecp_check_pubkey(&ctx.grp, &ctx.Q) == 0 );
    //hash_z
    TEST_ASSERT( mbedtls_sm2_hash_z(&ctx, MBEDTLS_MD_SM3, user_id, sizeof(user_id), hash_z) == 0 );
    //hash_e-to-hash_md
    TEST_ASSERT( mbedtls_sm2_hash_e(MBEDTLS_MD_SM3, hash_z, M->x, M->len, hash_md) == 0 );
    //sign
    TEST_ASSERT( mbedtls_sm2_sign_raw(&ctx, MBEDTLS_MD_SM3, hash_md, sgn, &slen, &mbedtls_test_rnd_pseudo_rand, &rnd_info) == 0 );
    //verify
    TEST_ASSERT( mbedtls_sm2_verify_raw(&ctx, MBEDTLS_MD_SM3, hash_md, sizeof(hash_md), sgn) == 0 );
}
/* END_CASE */